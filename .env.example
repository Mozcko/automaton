# Data Crab exchange configuration
AUTOMATON_NAME=data-crab
CREATOR_ADDRESS=0xyour_creator_wallet_address
EXCHANGE_ID=binance
EXCHANGE_API_KEY=your_binance_api_key
EXCHANGE_API_SECRET=your_binance_api_secret

# Trading allocation and hard stop loss
INITIAL_ALLOCATION_USD=50
MAX_LOSS_USD=5
# Optional historical PnL reference. Omit this to establish the baseline from
# the first successfully valued live exchange balance after deployment.
# PNL_BASELINE_USD=50

# Provider keys. Do not commit real keys.
DEEPSEEK_API_KEY=sk-your-deepseek-key
OPENAI_API_KEY=sk-your-openai-key

# Routine trading uses DeepSeek first, then OpenAI if DeepSeek is exhausted,
# rate-limited, or rejects a token/context-limited request. Any valid OpenAI
# model id can be used here, including newer models such as gpt-5.6.
FAST_TRADING_MODEL=deepseek-chat
FAST_TRADING_FALLBACK_MODEL=gpt-5.6

# Gross exchange PnL only. API and hosting costs are intentionally excluded.
DAILY_GROSS_PROFIT_TARGET_USD=2.00
DAILY_GROSS_PROFIT_RAISE_USD=0.20

# Optional advanced configuration. Simple variables above override these two
# fast-trading fields when both are present.
MODEL_STRATEGY='{"slowEvolutionModel":"deepseek-coder","slowEvolutionFallbackModel":"gpt-4.1","fastTradingMaxTokens":1024}'
